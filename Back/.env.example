# --- SEGURIDAD ---
# Cadena larga y aleatoria para firmar los JWT. Cámbiala en tu .env local.
SECRET_KEY="change-me-with-a-long-random-string"

# --- BASE DE DATOS ---
DB_ENGINE="sqlite"  # Puede ser "sqlite" o "mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="subsonic_db"

# --- CORS ---
# Puedes sobreescribir los orígenes aquí pasándolos como un string JSON
# CORS_ORIGINS='["http://localhost:3000", "https://misubsonic.com"]'

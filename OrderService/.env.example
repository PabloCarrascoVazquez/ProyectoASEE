# ===================================================
# Microservicio de Pedidos y Acceso (Wallet) - Subsonic Festival
# ===================================================

PORT=8005
# Debe coincidir con el SECRET_KEY del resto de microservicios
SECRET_KEY=super-secret-subsonic-key-jwt-2026

# Secreto propio para firmar los QR (si se omite se deriva de SECRET_KEY)
QR_SECRET_KEY=super-secret-subsonic-qr-key-2026
QR_TOKEN_EXPIRE_MINUTES=60
# Roles que pueden validar QR en puerta
STAFF_ROLES=["admin", "staff"]

# DB_ENGINE=sqlite | postgres
DB_ENGINE=sqlite
SQLITE_DB_PATH=orders.db

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=orders_db
DB_USER=postgres
DB_PASSWORD=postgres

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_RECONNECT_SECONDS=10

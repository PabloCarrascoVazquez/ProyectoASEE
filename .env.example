# ===================================================================
# Configuración Global Unificada - Subsonic Festival (Microservicios)
# ===================================================================

# --- Seguridad y JWT (Compartido por todos los microservicios) ---
SECRET_KEY=super-secret-subsonic-key-jwt-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Códigos QR y Control de Acceso (OrderService) ---
QR_SECRET_KEY=super-secret-subsonic-qr-key-2026
QR_TOKEN_EXPIRE_MINUTES=60
STAFF_ROLES=["admin", "staff"]

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# --- Base de Datos (sqlite | mysql) ---
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# --- Puertos por Microservicio ---
USER_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
PURCHASE_SERVICE_PORT=8003
INVENTORY_SERVICE_PORT=8004
ORDER_SERVICE_PORT=8005
GATEWAY_PORT=8000

# --- Nombres de BD y Archivos SQLite por Microservicio ---
USER_DB_NAME=users_db
USER_SQLITE_PATH=users.db

CATALOG_DB_NAME=catalogo_db
CATALOG_SQLITE_PATH=catalogo.db

PURCHASE_DB_NAME=purchases_db
PURCHASE_SQLITE_PATH=purchases.db

INVENTORY_DB_NAME=shipinventory_db
INVENTORY_SQLITE_PATH=shipinventory.db

ORDER_DB_NAME=orders_db
ORDER_SQLITE_PATH=orders.db

# --- RabbitMQ ---
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_RECONNECT_SECONDS=10

# --- Comunicación Síncrona y Workers (PurchaseService) ---
CATALOG_SERVICE_URL=http://localhost:8002/api
INVENTORY_SERVICE_URL=http://localhost:8004/api
OUTBOX_WORKER_INTERVAL_MS=30000
EXPIRATION_WORKER_INTERVAL_MS=60000
CATALOG_MOCK_FALLBACK=true
INVENTORY_MOCK_FALLBACK=true
